# MCP Debat — Environment Variables
# Copy this file to .env and fill in your API keys.
# Providers without keys are skipped at startup.

# --- AI Provider API Keys ---
# At least 1 provider is required. More = better debate quality.

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# OpenAI Fallback via AWS Bedrock Mantle (auto-switch when primary quota exhausted)
# Leave empty to disable fallback
OPENAI_FALLBACK_KEY=

# Qwen via Ollama (optional — set to any non-empty value if using local Ollama)
QWEN_API_KEY=

# --- Server ---

# Port to listen on (default: 3900)
PORT=3900

# Auth token — clients must send this as Bearer token.
# Leave empty to disable auth (server binds to localhost only).
# Generate one: openssl rand -hex 32
AUTH_TOKEN=
