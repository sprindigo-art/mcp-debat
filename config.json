{
  "providers": {
    "deepseek": {
      "enabled": true,
      "name": "DeepSeek V4 Pro",
      "model": "deepseek-v4-pro",
      "baseURL": "https://api.deepseek.com",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "sdk": "openai",
      "timeout": 120000,
      "maxTokens": 2048,
      "costPer1M": { "input": 0.435, "output": 0.87 }
    },
    "gemini": {
      "enabled": true,
      "name": "Gemini 3.5 Flash",
      "model": "gemini-3.5-flash",
      "apiKeyEnv": "GEMINI_API_KEY",
      "sdk": "google",
      "timeout": 120000,
      "maxTokens": 8192,
      "jailbreak": true,
      "costPer1M": { "input": 2.00, "output": 12.00 }
    },
    "mistral": {
      "enabled": true,
      "name": "Mistral Medium 3.5",
      "model": "mistral-medium-2604",
      "baseURL": "https://api.mistral.ai/v1",
      "apiKeyEnv": "MISTRAL_API_KEY",
      "sdk": "openai",
      "timeout": 120000,
      "maxTokens": 2048,
      "costPer1M": { "input": 0.40, "output": 1.20 }
    },
    "anthropic": {
      "enabled": true,
      "name": "Claude Opus 4.6",
      "model": "claude-opus-4-6",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "sdk": "anthropic",
      "timeout": 120000,
      "maxTokens": 1536,
      "costPer1M": { "input": 15.00, "output": 75.00 }
    },
    "qwen": {
      "enabled": true,
      "name": "Qwen3 Coder 480B",
      "model": "qwen3-coder:480b",
      "baseURL": "https://ollama.com/api",
      "apiKeyEnv": "QWEN_API_KEY",
      "sdk": "ollama",
      "timeout": 120000,
      "maxTokens": 2048,
      "jailbreak": true,
      "costPer1M": { "input": 0.00, "output": 0.00 }
    },
    "openai": {
      "enabled": true,
      "name": "GPT-5.3 Codex",
      "model": "gpt-5.3-codex",
      "baseURL": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "sdk": "openai-responses",
      "timeout": 120000,
      "maxTokens": 2048,
      "costPer1M": { "input": 2.50, "output": 10.00 },
      "fallback": {
        "name": "GPT-5.5 (AWS Bedrock)",
        "model": "openai.gpt-5.5",
        "baseURL": "https://bedrock-mantle.us-east-2.api.aws/openai/v1",
        "apiKeyEnv": "OPENAI_FALLBACK_KEY",
        "costPer1M": { "input": 2.50, "output": 10.00 }
      }
    }
  },
  "debate": {
    "defaultRounds": 3,
    "maxRounds": 5,
    "historyMaxChars": 16000,
    "briefingMaxChars": 8000,
    "perPhaseMaxChars": 2000,
    "defaultStyle": "freeform",
    "hostWindowTimeout": 120000,
    "phaseTimeout": 600000,
    "modelResponseCap": 3000
  },
  "session": {
    "maxConcurrent": 50,
    "writeAfterEachModel": true,
    "storageDir": "sessions"
  },
  "memory": {
    "maxConclusions": 200,
    "storageDir": "memory"
  },
  "server": {
    "port": 3900,
    "authTokenEnv": "AUTH_TOKEN"
  },
  "executor": {
    "enabled": true,
    "maxCommandsPerResponse": 3,
    "maxCommandsPerSession": 50,
    "maxTimeout": 30000,
    "maxOutputChars": 10000,
    "maxCommandLength": 500,
    "allowedPaths": [
      "/var/www/mcp/debat/runbooks",
      "/var/www/mcp/debat/src",
      "/var/www/mcp/debat/config.json",
      "/var/www/mcp/debat/memory",
      "/var/www/mcp/debat/sessions",
      "/var/www/mcp/debat/scripts",
      "/var/www/mcp/debat/PLAN.md"
    ]
  }
}
